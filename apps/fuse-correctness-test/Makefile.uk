$(eval $(call addlib,appfuse_correctness_test))

APPFUSE_CORRECTNESS_TEST_CINCLUDES-y += -I$(APPFUSE_CORRECTNESS_TEST_BASE)/../../libs/libfuse/include/fuse
APPFUSE_CORRECTNESS_TEST_CINCLUDES-y += -I$(APPFUSE_CORRECTNESS_TEST_BASE)/../../libs/libfuse/include
APPFUSE_CORRECTNESS_TEST_CINCLUDES-y += -I$(APPFUSE_CORRECTNESS_TEST_BASE)/../../libs/libfuse/lib

APPFUSE_CORRECTNESS_TEST_SRCS-y += $(APPFUSE_CORRECTNESS_TEST_BASE)/main.c
APPFUSE_CORRECTNESS_TEST_SRCS-y += $(APPFUSE_CORRECTNESS_TEST_BASE)/hello_ll.c
APPFUSE_CORRECTNESS_TEST_HELLO_LL_FLAGS-y += -Dmain=fuse_backend_main
